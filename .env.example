# Copy to .env and fill in your own key. Never commit .env.
# IMPORTANT: the application currently reads process environment variables;
# it does NOT automatically load .env. Load these values into your environment
# before starting the server or CLI.

# API key shared by chat and embeddings at the configured base URL.
OPENAI_API_KEY=

# Base URL without /chat/completions or /embeddings.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model used unless overridden in an API request or the CLI --model option.
OPENAI_MODEL=gpt-5.4

# Embeddings are configured separately via --embedding-model in the research CLI
# (default: text-embedding-3-small), not via an environment variable.
# For the tested gpt-5.4 research CLI setup, pass --reasoning-effort none.
# Server port is configured via --port, not via an environment variable.
