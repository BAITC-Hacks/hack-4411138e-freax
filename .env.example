# Скопируйте файл в .env и укажите свой ключ. .env исключён из Git.
# run.sh и run.ps1 загружают .env автоматически.
# При прямом запуске server.py или CLI задайте переменные в окружении процесса.

# Ключ для анализа, чата и эмбеддингов у выбранного провайдера.
OPENAI_API_KEY=

# Базовый адрес без /chat/completions или /embeddings.
OPENAI_BASE_URL=https://api.openai.com/v1

# Модель по умолчанию; API config.model и CLI --model могут её переопределить.
OPENAI_MODEL=gpt-5.4

# Модель эмбеддингов задаётся в config.embedding_model или CLI --embedding-model
# (по умолчанию text-embedding-3-small), а не переменной окружения.
# Для проверенной настройки gpt-5.4 в research CLI: --reasoning-effort none.
# Порт задаётся аргументом --port, например: ./run.sh --port 9000.
